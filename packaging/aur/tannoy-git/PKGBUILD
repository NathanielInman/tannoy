# Maintainer: Nathaniel Inman

pkgname=tannoy-git
pkgver=0.1.0.r11.g17af2d4
pkgrel=1
pkgdesc="Now playing for waybar: every MPRIS player, cover art in the bar and a drawer that opens from the icon (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/NathanielInman/tannoy"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=(
  'waybar: the bar the modules are made for'
  'hyprland: open the drawer from the clicked icon and hide titles while sharing the screen'
  'swaync: hide titles while do not disturb is on'
  'wireplumber: show the output device in the drawer (wpctl)'
)
provides=('tannoy')
conflicts=('tannoy')
# makepkg's -flto turns ring's C objects into GCC bitcode that rust-lld cannot
# link. The release profile already has thin LTO for the Rust code.
options=('!lto')
source=("tannoy::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd tannoy
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd tannoy
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd tannoy
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p tannoy -p tannoy-board
}

check() {
  cd tannoy
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --workspace
}

package() {
  cd tannoy
  install -Dm755 target/release/tannoy target/release/tannoy-board -t "$pkgdir/usr/bin/"
  install -Dm644 packaging/systemd/tannoy.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 packaging/man/tannoy.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 packaging/completions/tannoy.bash "$pkgdir/usr/share/bash-completion/completions/tannoy"
  install -Dm644 packaging/completions/_tannoy -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 packaging/completions/tannoy.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
